# Zuno Backend Environment Variables
# Copy to .env and fill in your keys

# ─── AI ──────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Web Search (pick ONE) ────────────────────────
# Option A: Brave Search — https://api.search.brave.com (recommended)
BRAVE_SEARCH_API_KEY=your_brave_api_key_here

# Option B: Serper (Google results) — https://serper.dev
# SERPER_API_KEY=your_serper_api_key_here

# ─── Server ──────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:3000

# ─── Training Data ───────────────────────────────
TRAINING_LOG_DIR=./data/training
